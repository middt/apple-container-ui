# Copy to .env. VNEXT_DOCKER_DIR = <vnext-runtime checkout>/vnext/docker
# The remaining values mirror <VNEXT_DOCKER_DIR>/domains/<DOMAIN_NAME>/.env (make create-domain).
VNEXT_DOCKER_DIR=/Volumes/Data/burgan-tech/github/vnext-runtime/vnext/docker
DOMAIN_NAME=core
VNEXT_APP_PORT=4201
VNEXT_EXECUTION_PORT=4202
VNEXT_INBOX_PORT=4203
VNEXT_OUTBOX_PORT=4204
VNEXT_INIT_PORT=3005
DAPR_ORCHESTRATION_HTTP_PORT=42110
DAPR_ORCHESTRATION_GRPC_PORT=42111
DAPR_EXECUTION_HTTP_PORT=43110
DAPR_EXECUTION_GRPC_PORT=43111
DAPR_INBOX_HTTP_PORT=44110
DAPR_INBOX_GRPC_PORT=44111
DAPR_OUTBOX_HTTP_PORT=45110
DAPR_OUTBOX_GRPC_PORT=45111
DAPR_DBMIGRATOR_HTTP_PORT=46110
DAPR_DBMIGRATOR_GRPC_PORT=46111
VNEXT_VERSION=latest
